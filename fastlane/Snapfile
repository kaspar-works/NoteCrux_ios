devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

languages([
  "en-US"
])

scheme("NoteCrux")

output_directory("./fastlane/screenshots")

clear_previous_screenshots(true)

override_status_bar(true)

# Arguments injected into the app so it launches into a predictable state
# for screenshots (see DebugSeed + ContentView).
launch_arguments([
  "NC_SCREENSHOT_MODE -NC_SEED_DATA"
])
